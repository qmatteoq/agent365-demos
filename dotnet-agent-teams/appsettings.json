{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Agents.A365.Observability": "Debug",
      "OpenTelemetry": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureOpenAI": {
    "Endpoint": "https://agentcon2025-resource.openai.azure.com/",
    "Deployment": "gpt-4.1",
    "TenantId": "57db880c-370a-428d-9139-2b346b4eb220",
    "//": "Set UseManagedIdentity to true only when the agent runs on Azure infrastructure. Off Azure there is no IMDS endpoint and managed identity fails fatally instead of falling through to the az CLI credential.",
    "UseManagedIdentity": false
  },
  "LearnMcp": {
    "Endpoint": "https://learn.microsoft.com/api/mcp"
  },
  "//": "Two identities are in play. BotConnection is a plain Entra app that authenticates the Teams / Microsoft 365 Copilot channel: agentic applications are barred from client-credentials tokens (AADSTS82001), so the Agent 365 blueprint cannot do this job. ServiceConnection stays on the blueprint so Agent 365 governance and Work IQ tools keep attributing to the governed identity. Observability does not use it: the exporter exchanges the signed-in user's turn token for the observability scope (OBO), so a trace records the person who asked. NOTE: /api/messages is currently mapped without authentication middleware, so TokenValidation is not yet enforced - wire AddAgentAspNetAuthentication and RequireAuthorization before exposing the agent publicly. Secrets live in user-secrets, never in this file.",
  "TokenValidation": {
    "Audiences": [
      "0cf93255-7aee-4542-8df9-fc53bb8af150"
    ],
    "Enabled": true,
    "TenantId": "57db880c-370a-428d-9139-2b346b4eb220"
  },
  "Connections": {
    "BotConnection": {
      "Settings": {
        "AuthType": "ClientSecret",
        "AuthorityEndpoint": "https://login.microsoftonline.com/57db880c-370a-428d-9139-2b346b4eb220",
        "ClientId": "0cf93255-7aee-4542-8df9-fc53bb8af150",
        "ClientSecret": "",
        "Scopes": [
          "https://api.botframework.com/.default"
        ]
      }
    },
    "ServiceConnection": {
      "Settings": {
        "AuthType": "ClientSecret",
        "AuthorityEndpoint": "https://login.microsoftonline.com/57db880c-370a-428d-9139-2b346b4eb220",
        "ClientId": "f56c2c54-5fb4-4097-a73e-95970ea5b8f7",
        "ClientSecret": "",
        "Scopes": [
          "5a807f24-c9de-44ee-a3a7-329e88a00ffc/.default"
        ],
        "AgentId": "f56c2c54-5fb4-4097-a73e-95970ea5b8f7"
      }
    }
  },
  "ConnectionsMap": [
    {
      "ServiceUrl": "*",
      "Connection": "BotConnection"
    }
  ],
  "AgentApplication": {
    "StartTypingTimer": false,
    "RemoveRecipientMention": false,
    "NormalizeMentions": false,
    "AgenticAuthHandlerName": "agentic",
    // Classic Teams turns are not agentic requests, so the agentic handler cannot mint a
    // token for them. Those turns use the OBO handler instead: the user signs in through
    // Teams and the agent exchanges that delegated token for the WorkIQ MCP audiences and
    // the observability scope. Without this, the tooling gateway returns 400 and the
    // observability exporter logs "No token obtained".
    "OboAuthHandlerName": "obo",
    // Observability uses its OWN handler, fronting a second Azure Bot OAuth connection whose
    // Scopes are set to the Agent 365 Observability API. That scope is what makes the Bot
    // Framework Token Service perform the on-behalf-of exchange itself, so GetTurnTokenAsync
    // returns a token already scoped to the resource and no MSAL chain is needed. It must stay
    // separate from "obo": re-scoping BotOAuth would move its audience off api://botid-… and
    // break the WorkIQ exchange, which uses that token as its user assertion.
    "ObservabilityAuthHandlerName": "observability",
    "UserAuthorization": {
      // Sign-in is attached per-route in LearnAgent (message route only) instead of globally.
      // With AutoSignIn true the SDK prompts on every activity, including the install-time
      // conversationUpdate, which surfaced a sign-in failure before the user asked anything.
      "AutoSignIn": false,
      "DefaultHandlerName": "obo",
      "Handlers": {
        // No "Type" key here on purpose - the SDK infers the Azure Bot OAuth flow from the
        // presence of AzureBotOAuthConnectionName. OBOConnectionName must point at the bot
        // channel app's own credentials (BotConnection), NOT the blueprint: the OBO exchange
        // has to be performed by the same app the Azure Bot OAuth connection is registered to.
        "obo": {
          "Settings": {
            "AzureBotOAuthConnectionName": "BotOAuth",
            "OBOConnectionName": "BotConnection"
          }
        },
        // Fronts the oboConnectionProfile connection, created with:
        //   az bot authsetting create -g <rg> -n <bot> -c oboConnectionProfile \
        //     --client-id <bot-app-id> --client-secret <secret> --service Aadv2 \
        //     --provider-scope-string "api://9b975845-388f-4429-889e-eab1ef63949c/Agent365.Observability.OtelWrite" \
        //     --parameters tenantID=<tenant> tokenExchangeUrl=api://botid-<bot-app-id>
        // Sharing tokenExchangeUrl with BotOAuth is what keeps Teams SSO silent for both.
        "observability": {
          "Settings": {
            "AzureBotOAuthConnectionName": "oboConnectionProfile",
            "OBOConnectionName": "BotConnection",
            "Scopes": [
              "api://9b975845-388f-4429-889e-eab1ef63949c/Agent365.Observability.OtelWrite"
            ]
          }
        },
        "agentic": {
          "Type": "AgenticUserAuthorization",
          "Settings": {
            "AlternateBlueprintConnectionName": "ServiceConnection",
            "Scopes": [
              "https://graph.microsoft.com/.default"
            ]
          }
        }
      }
    }
  },
  "EnableAgent365Exporter": true,
  "Agent365Observability": {
    "AgentId": "a349a3ca-4c84-4165-be0a-8a0e5041b460",
    "AgentName": "dotnet-agent-teams Identity",
    "AgentDescription": "dotnet-agent-teams",
    "TenantId": "57db880c-370a-428d-9139-2b346b4eb220",
    "AgentBlueprintId": "f56c2c54-5fb4-4097-a73e-95970ea5b8f7",
    // The blueprint's own credential drives hop 2 of the token chain (the fmi_path exchange that
    // proves it owns the agent identity), for both WorkIQ and observability. The real value lives
    // in user secrets, never here.
    "ClientSecret": ""
  }
}
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "AzureOpenAI": {
    "Endpoint": "https://agentcon2025-resource.openai.azure.com/",
    "Deployment": "gpt-4.1",
    "TenantId": "57db880c-370a-428d-9139-2b346b4eb220"
  },

  "LearnMcp": {
    "Endpoint": "https://learn.microsoft.com/api/mcp"
  },

  "//": "Anonymous until onboarded: with an empty TokenValidation.Audiences the agent runs in the Microsoft 365 Agents Playground with no setup. Unlike dotnet-agent-teams there is no Azure Bot registration to fill in - this agent is onboarded as an Agent 365 AI Teammate, and 'a365 setup all --aiteammate --m365' registers the messaging endpoint on the blueprint and fills in the Connections / TokenValidation / AgentApplication ids below.",

  "AgentApplication": {
    "StartTypingTimer": false,
    "RemoveRecipientMention": false,
    "NormalizeMentions": false,
    "AgenticAuthHandlerName": "agentic",
    "UserAuthorization": {
      "AutoSignin": false,
      "Handlers": {
        "agentic": {
          "Type": "AgenticUserAuthorization",
          "Settings": {
            "Scopes": [
              "https://graph.microsoft.com/.default"
            ],
            "AlternateBlueprintConnectionName": "ServiceConnection"
          }
        }
      }
    }
  },

  "TokenValidation": {
    "Audiences": []
  },

  "Connections": {
    "ServiceConnection": {
      "Settings": {
        "AuthType": "UserManagedIdentity",
        "AuthorityEndpoint": "https://login.microsoftonline.com/57db880c-370a-428d-9139-2b346b4eb220",
        "ClientId": "",
        "AgentId": "",
        "Scopes": [
          "5a807f24-c9de-44ee-a3a7-329e88a00ffc/.default"
        ]
      }
    }
  },

  "ConnectionsMap": [
    {
      "ServiceUrl": "*",
      "Connection": "ServiceConnection"
    }
  ]
}

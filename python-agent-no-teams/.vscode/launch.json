{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Microsoft Learn agent",
      "type": "debugpy",
      "request": "launch",
      "module": "app.main",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "preLaunchTask": "sync dependencies",
      // Use the project's own virtual environment rather than whatever interpreter
      // VS Code happens to have selected.
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "serverReadyAction": {
        "pattern": "Uvicorn running on (https?://[^ ]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}

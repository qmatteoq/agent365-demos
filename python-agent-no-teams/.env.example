# Azure OpenAI resource that hosts the chat deployment.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-10-21

# Tenant that owns the Azure OpenAI resource. Without this, a token from another tenant
# makes Azure OpenAI answer HTTP 400 "Tenant provided in token does not match resource token".
AZURE_OPENAI_TENANT_ID=00000000-0000-0000-0000-000000000000

# false locally (uses the Azure CLI credential), true when hosted on Azure.
AZURE_OPENAI_USE_MANAGED_IDENTITY=false

LEARN_MCP_ENDPOINT=https://learn.microsoft.com/api/mcp

HOST=127.0.0.1
PORT=8000

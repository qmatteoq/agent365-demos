# Azure OpenAI resource that hosts the chat deployment.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-10-21

# Tenant that owns the Azure OpenAI resource. Without this, a token from another tenant
# makes Azure OpenAI answer HTTP 400 "Tenant provided in token does not match resource token".
AZURE_OPENAI_TENANT_ID=00000000-0000-0000-0000-000000000000

# false locally (uses the Azure CLI credential), true when hosted on Azure.
AZURE_OPENAI_USE_MANAGED_IDENTITY=false

LEARN_MCP_ENDPOINT=https://learn.microsoft.com/api/mcp

HOST=127.0.0.1
PORT=8000

# ── Agent 365 ────────────────────────────────────────────────────────────────
# Written by 'a365 setup all'. AGENT365OBSERVABILITY__AGENTID is the agent
# identity - that is the id Microsoft Defender reports against, not the blueprint.
AGENT365OBSERVABILITY__AGENTID=
AGENT365OBSERVABILITY__AGENTNAME=
AGENT365OBSERVABILITY__AGENTDESCRIPTION=
AGENT365OBSERVABILITY__TENANTID=
AGENT365OBSERVABILITY__AGENTBLUEPRINTID=
AGENT365OBSERVABILITY__CLIENTID=
AGENT365OBSERVABILITY__CLIENTSECRET=
ENABLE_A365_OBSERVABILITY_EXPORTER=true

# Interactive sign-in app (created separately - a blueprint cannot run /authorize).
# Needs delegated api://<blueprint>/access_agent_as_user with admin consent.
A365_WEBCLIENT_CLIENT_ID=
A365_WEBCLIENT_CLIENT_SECRET=
A365_WEBCLIENT_REDIRECT_URI=http://localhost:8000/signin-oidc
SESSION_SECRET=

# ── Observability verbose logging ────────────────────────────────────────────
OTEL_LOG_LEVEL=INFO
A365_OBSERVABILITY_LOG_LEVEL=info|warn|error
# Rename to .env and fill in. This file is safe to commit; .env is gitignored.

# ── Microsoft 365 Agents SDK ─────────────────────────────────────────────────────────
# The Azure Bot registration's Entra app. NOT the Agent 365 blueprint: Entra bars agentic
# applications from client-credentials tokens (AADSTS82001), so a blueprint cannot
# authenticate the outbound Bot Framework replies.
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=
CONNECTIONSMAP__0__SERVICEURL=*
CONNECTIONSMAP__0__CONNECTION=SERVICE_CONNECTION

# ── Azure OpenAI ─────────────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-10-21
# Tenant that owns the Azure OpenAI resource; pins the Azure CLI credential.
AZURE_OPENAI_TENANT_ID=
# Set to true only when hosted on Azure with a managed identity assigned.
AZURE_OPENAI_USE_MANAGED_IDENTITY=false

# ── Agent ────────────────────────────────────────────────────────────────────────────
LEARN_MCP_ENDPOINT=https://learn.microsoft.com/api/mcp
PORT=3979

# ── Agent 365 observability ──────────────────────────────────────────────────────────
# Written by `a365 setup all`. That command also OVERWRITES the three
# CONNECTIONS__SERVICE_CONNECTION__* values above with the blueprint's - restore them to
# the bot app afterwards or Teams breaks with AADSTS82001.
#
# The blueprint is hop 1 of the token exchange that authenticates the exporter as the
# agent identity. It is deliberately not wired as an Agents SDK connection.
ENABLE_A365_OBSERVABILITY_EXPORTER=false
AGENT365OBSERVABILITY__AGENTID=
AGENT365OBSERVABILITY__AGENTNAME=
AGENT365OBSERVABILITY__AGENTDESCRIPTION=
AGENT365OBSERVABILITY__TENANTID=
AGENT365OBSERVABILITY__AGENTBLUEPRINTID=
AGENT365OBSERVABILITY__CLIENTID=
AGENT365OBSERVABILITY__CLIENTSECRET=
# Successful exports are logged at debug; add "debug" here to confirm spans left the process.
A365_OBSERVABILITY_LOG_LEVEL=warn|error

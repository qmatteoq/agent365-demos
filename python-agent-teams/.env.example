# Rename to .env and fill in. This file is safe to commit; .env is gitignored.

# ── Microsoft 365 Agents SDK ─────────────────────────────────────────────────────────
# The Azure Bot registration's Entra app. NOT the Agent 365 blueprint: Entra bars agentic
# applications from client-credentials tokens (AADSTS82001), so a blueprint cannot
# authenticate the outbound Bot Framework replies.
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=
CONNECTIONSMAP__0__SERVICEURL=*
CONNECTIONSMAP__0__CONNECTION=SERVICE_CONNECTION

# ── Azure OpenAI ─────────────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-10-21
# Tenant that owns the Azure OpenAI resource; pins the Azure CLI credential.
AZURE_OPENAI_TENANT_ID=
# Set to true only when hosted on Azure with a managed identity assigned.
AZURE_OPENAI_USE_MANAGED_IDENTITY=false

# ── Agent ────────────────────────────────────────────────────────────────────────────
LEARN_MCP_ENDPOINT=https://learn.microsoft.com/api/mcp
PORT=3979

# ── User authorization (Teams SSO) ───────────────────────────────────────────────────
# The OBO handler signs the Teams user in silently and hands back a token whose audience
# is the bot channel app. That token is the starting assertion of the observability token
# chain, which is what puts the human caller on every trace.
#
# No TYPE key on purpose - the SDK infers the Azure Bot OAuth flow from the presence of
# AZUREBOTOAUTHCONNECTIONNAME. OBOCONNECTIONNAME must name the connection holding the bot
# channel app's own credentials, because the exchange has to be performed by the same app
# the Azure Bot OAuth connection is registered to.
#
# The handler name (OBO below) is case-sensitive to the SDK and os.environ upper-cases
# every key on Windows, so keep it uppercase.
AGENTAPPLICATION__USERAUTHORIZATION__DEFAULTHANDLERNAME=OBO
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__OBO__SETTINGS__AZUREBOTOAUTHCONNECTIONNAME=BotOAuth
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__OBO__SETTINGS__OBOCONNECTIONNAME=SERVICE_CONNECTION

# ── Agent 365 observability ──────────────────────────────────────────────────────────
# Written by `a365 setup all`. That command also OVERWRITES the three
# CONNECTIONS__SERVICE_CONNECTION__* values above with the blueprint's - restore them to
# the bot app afterwards or Teams breaks with AADSTS82001.
#
# The exporter's token is minted per turn by a three-hop on-behalf-of chain:
#   bot app -> blueprint (access_agent_as_user)
#   blueprint -> token-exchange assertion (fmi_path = the agent identity)
#   agent identity -> Observability API, on behalf of the user
# The export route authorises on the token's `azp`, which is why the last hop has to be
# performed by the agent identity rather than the bot app or the blueprint.
#
# The blueprint is deliberately not wired as an Agents SDK connection.
ENABLE_A365_OBSERVABILITY_EXPORTER=false
AGENT365OBSERVABILITY__AGENTID=
AGENT365OBSERVABILITY__AGENTNAME=
AGENT365OBSERVABILITY__AGENTDESCRIPTION=
AGENT365OBSERVABILITY__TENANTID=
AGENT365OBSERVABILITY__AGENTBLUEPRINTID=
AGENT365OBSERVABILITY__CLIENTID=
AGENT365OBSERVABILITY__CLIENTSECRET=
# Successful exports are logged at debug; add "debug" here to confirm spans left the process.
A365_OBSERVABILITY_LOG_LEVEL=warn|error

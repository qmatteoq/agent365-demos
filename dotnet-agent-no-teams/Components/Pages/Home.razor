@page "/"
@rendermode InteractiveServer
@using System.Security.Claims
@using LearnMcpAgent.Agent365
@using Microsoft.Agents.AI
@using Microsoft.Agents.A365.Observability.Runtime.Common
@using Microsoft.Agents.A365.Observability.Runtime.Tracing.Contracts
@using Microsoft.Agents.A365.Observability.Runtime.Tracing.Scopes
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Identity.Web
@attribute [Authorize]
@inject LearnAgentFactory AgentFactory
@inject A365Config A365
@inject AgentOboTokenService OboTokens
@inject ObservabilityTokenStore TokenStore
@inject ITokenAcquisition TokenAcquisition
@inject MicrosoftIdentityConsentAndConditionalAccessHandler ConsentHandler
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<Home> Logger
@implements IAsyncDisposable

<PageTitle>Microsoft Learn Agent</PageTitle>

<div class="chat-container">
    <h1>Microsoft Learn Agent</h1>
    <p class="subtitle">
        Microsoft Agent Framework (.NET) + Azure OpenAI + Microsoft Learn MCP &mdash; traced with Agent 365
    </p>

    <div class="messages">
        @if (_messages.Count == 0 && !_isThinking)
        {
            <p class="empty">Ask me anything about Azure, Microsoft 365, .NET, Power Platform or any other Microsoft technology.</p>
        }
        @foreach (var msg in _messages)
        {
            <div class="msg @msg.Role">
                <div class="role">@msg.Role</div>
                <div class="text">@msg.Text</div>
                @if (msg.Tools.Count > 0)
                {
                    <div class="tools">
                        @foreach (var tool in msg.Tools)
                        {
                            <span class="chip" title="@tool.ToolName">@tool.Source · @tool.ToolName</span>
                        }
                    </div>
                }
            </div>
        }
        @if (_isThinking)
        {
            <div class="msg assistant">
                <div class="role">assistant</div>
                <div class="text"><em>@(_currentActivity ?? "Thinking...")</em></div>
                @if (_turnTools.Count > 0)
                {
                    <div class="tools">
                        @foreach (var tool in _turnTools)
                        {
                            <span class="chip">@tool.Source · @tool.ToolName</span>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <EditForm Model="this" OnValidSubmit="SendAsync" class="input-row">
        <InputText @bind-Value="_input" placeholder="Ask about a Microsoft technology..." disabled="@_isThinking" class="input" />
        <button type="submit" disabled="@(_isThinking || string.IsNullOrWhiteSpace(_input))">Send</button>
    </EditForm>

    @if (_observabilityWarning is not null)
    {
        <p class="warn">Observability: @_observabilityWarning</p>
    }
</div>

<style>
    .chat-container { max-width: 860px; margin: 1rem auto; font-family: system-ui, sans-serif; }
    .subtitle { color: #666; font-size: 0.9rem; }
    .empty { color: #999; font-style: italic; }
    .warn { color: #a15c00; font-size: 0.8rem; margin-top: 0.5rem; }
    .messages { border: 1px solid #ddd; border-radius: 8px; padding: 1rem; min-height: 400px; max-height: 60vh; overflow-y: auto; background: #fafafa; }
    .msg { margin-bottom: 1rem; }
    .msg .role { font-weight: bold; font-size: 0.8rem; text-transform: uppercase; color: #888; }
    .msg.user .text { background: #d6e4ff; padding: 0.5rem 0.75rem; border-radius: 6px; display: inline-block; }
    .msg.assistant .text { background: #fff; padding: 0.5rem 0.75rem; border-radius: 6px; border: 1px solid #e0e0e0; white-space: pre-wrap; }
    .tools { margin-top: 0.4rem; display: flex; flex-wrap: wrap; gap: 0.35rem; }
    .chip { font-size: 0.72rem; background: #eef3fb; color: #21486e; border: 1px solid #c9d9ee; border-radius: 999px; padding: 0.1rem 0.55rem; font-family: ui-monospace, Consolas, monospace; }
    .input-row { display: flex; gap: 0.5rem; margin-top: 1rem; }
    .input { flex: 1; padding: 0.5rem; font-size: 1rem; border: 1px solid #ccc; border-radius: 6px; }
    button { padding: 0.5rem 1.25rem; font-size: 1rem; border: none; border-radius: 6px; background: #0066cc; color: #fff; cursor: pointer; }
    button:disabled { background: #aaa; cursor: not-allowed; }
</style>

@code {
    // Observability API — the resource the agent posts its OTLP traces to.
    private const string ObservabilityScope = "api://9b975845-388f-4429-889e-eab1ef63949c/.default";

    private readonly List<ChatEntry> _messages = new();

    // Tools called during the turn that is currently running.
    private readonly List<ToolInvocation> _turnTools = new();

    private readonly ToolActivityReporter _toolReporter = new();

    // A web agent has no ITurnContext-supplied conversation id, so generate one per circuit and
    // reuse it for every turn. All spans in the session then share a gen_ai.conversation.id.
    private readonly string _conversationId = Guid.NewGuid().ToString("N");

    private AIAgent? _agent;
    private AgentSession? _session;
    private string _input = string.Empty;
    private bool _isThinking;
    private string? _currentActivity;
    private string? _observabilityWarning;
    private ClaimsPrincipal? _user;

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;

        // Every tool call is announced before it runs, so the UI reflects what the agent is really
        // doing rather than a fixed placeholder.
        _toolReporter.ToolInvoked += async invocation =>
        {
            _turnTools.Add(invocation);
            _currentActivity = DescribeActivity(invocation);
            await InvokeAsync(StateHasChanged);
        };
    }

    private static string DescribeActivity(ToolInvocation invocation) =>
        invocation.Source == "Microsoft Learn"
            ? $"Searching Microsoft Learn ({invocation.ToolName})..."
            : $"Using {invocation.Source} ({invocation.ToolName})...";

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_input) || _isThinking) return;

        var userText = _input.Trim();
        _input = string.Empty;
        _messages.Add(new ChatEntry("user", userText));
        _turnTools.Clear();
        _currentActivity = null;
        _isThinking = true;

        try
        {
            // One user token serves both purposes: it is the assertion for the observability token
            // exchange and for the per-audience WorkIQ tokens.
            var userAssertion = await AcquireUserAssertionAsync();
            var hasObservability = await PrepareObservabilityTokenAsync(userAssertion);

            // A365 WorkIQ — added by add-workiq-tools skill.
            // Tools must be supplied at agent creation, and the WorkIQ tools are user-specific, so
            // the agent is built on the first turn once the user's token is available.
            if (_agent is null)
            {
                _currentActivity = "Connecting to Microsoft Learn and Microsoft 365 tools...";
                StateHasChanged();

                _agent = await AgentFactory.CreateAsync(userAssertion, _toolReporter);
                _session = await _agent.CreateSessionAsync();
            }

            _currentActivity = "Thinking...";

            using var baggageScope = hasObservability ? BuildBaggageScope() : null;
            using var invokeScope = hasObservability ? StartInvokeScope(userText) : null;

            invokeScope?.RecordInputMessages([userText]);

            // The IChatClient is wrapped with UseOpenTelemetry, so gen_ai inference and tool spans
            // are emitted automatically as children of this scope. They do not reach Agent 365 on
            // their own, though - Microsoft.Extensions.AI sets gen_ai.operation.name after starting
            // the span, so the SDK's OnStart enrichment misses it and the exporter drops it for
            // missing tenant/agent id. BaggageBackfillProcessor is what rescues them.
            var response = await _agent.RunAsync(userText, _session);

            invokeScope?.RecordOutputMessages([response.Text]);
            _messages.Add(new ChatEntry("assistant", response.Text) { Tools = [.. _turnTools] });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Agent turn failed.");
            _messages.Add(new ChatEntry("assistant", $"Error: {ex.Message}"));
        }
        finally
        {
            _isThinking = false;
            _currentActivity = null;
        }
    }

    // Requests the token whose audience is the agent blueprint. It is the user assertion for every
    // downstream agent on-behalf-of exchange.
    private async Task<string?> AcquireUserAssertionAsync()
    {
        try
        {
            return await TokenAcquisition.GetAccessTokenForUserAsync([A365.AgentUserScope]);
        }
        catch (Exception ex)
        {
            // Consent or conditional access needs an interactive round trip.
            ConsentHandler.HandleException(ex);
            Logger.LogWarning(ex, "Could not acquire the user assertion for the agent blueprint.");
            return null;
        }
    }

    // Exchanges the user assertion through the agent OBO chain and hands the resulting
    // Observability API token to the exporter's token resolver.
    private async Task<bool> PrepareObservabilityTokenAsync(string? userAssertion)
    {
        if (string.IsNullOrEmpty(userAssertion))
        {
            _observabilityWarning = "no user token — traces are not exported.";
            return false;
        }

        if (string.IsNullOrEmpty(A365.AgentIdentityClientId) || string.IsNullOrEmpty(A365.TenantId))
        {
            _observabilityWarning = "agent identity not configured — run 'a365 setup all'.";
            return false;
        }

        var agentToken = await OboTokens.GetAgentTokenAsync(userAssertion, ObservabilityScope);

        if (string.IsNullOrEmpty(agentToken))
        {
            _observabilityWarning = "could not obtain an Observability API token — traces are not exported.";
            return false;
        }

        TokenStore.Set(A365.AgentIdentityClientId, A365.TenantId, agentToken);
        _observabilityWarning = null;
        return true;
    }

    private IDisposable BuildBaggageScope()
    {
        // Baggage is what reaches the child inference and tool spans. CallerDetails on the
        // InvokeAgentScope below only decorates the parent span, so without these three the
        // tool calls arrive anonymous. There is no TurnContext here - this is a plain web app,
        // not a Bot Framework turn - so FromTurnContext is unavailable and the user is read
        // straight off the signed-in principal.
        var (userId, userName, userEmail) = ResolveCaller();

        return new BaggageBuilder()
            .TenantId(A365.TenantId)
            .AgentId(A365.AgentIdentityClientId)
            .AgentName(A365.AgentName)
            .AgentBlueprintId(A365.BlueprintClientId)
            .ConversationId(_conversationId)
            .SessionId(_conversationId)
            .UserId(userId)
            .UserName(userName)
            .UserEmail(userEmail)
            // Not a Teams-hosted agent — use a logical channel name for the web UI.
            .ChannelName("web")
            .Build();
    }

    /// <summary>
    /// Reads the caller off the signed-in principal. Shared by the baggage scope and the
    /// InvokeAgentScope so the parent span and its children can never disagree about who asked.
    /// </summary>
    private (string UserId, string UserName, string UserEmail) ResolveCaller() =>
    (
        _user?.FindFirst("oid")?.Value
            ?? _user?.FindFirst(ClaimTypes.NameIdentifier)?.Value
            ?? "unknown",
        _user?.Identity?.Name ?? "unknown",
        _user?.FindFirst("preferred_username")?.Value
            ?? _user?.FindFirst(ClaimTypes.Email)?.Value
            ?? string.Empty
    );

    private InvokeAgentScope StartInvokeScope(string userText)
    {
        var agentDetails = new AgentDetails(
            agentId: A365.AgentIdentityClientId,
            agentName: A365.AgentName,
            agentDescription: "Microsoft Learn research agent",
            agentBlueprintId: A365.BlueprintClientId,
            tenantId: A365.TenantId);

        var (userId, userName, userEmail) = ResolveCaller();

        var callerDetails = new CallerDetails(
            userDetails: new UserDetails(
                userId: userId,
                userName: userName,
                userEmail: userEmail));

        // Blueprint id is a GUID and therefore always URI-safe; the display name is not.
        var endpoint = new Uri($"https://{A365.BlueprintClientId}.agent.invalid/");

        return InvokeAgentScope.Start(
            new Request(userText),
            new InvokeAgentScopeDetails(endpoint: endpoint),
            agentDetails,
            callerDetails);
    }

    public ValueTask DisposeAsync()
    {
        if (_session is IAsyncDisposable d) return d.DisposeAsync();
        return ValueTask.CompletedTask;
    }

    private sealed record ChatEntry(string Role, string Text)
    {
        public IReadOnlyList<ToolInvocation> Tools { get; init; } = [];
    }
}
